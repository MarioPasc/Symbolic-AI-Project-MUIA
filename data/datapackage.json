          { "name": "condition_id", "type": "string", "constraints": { "required": true, "pattern": "^[A-Z0-9]+$" } },
          { "name": "name_es", "type": "string", "constraints": { "required": true } },
          { "name": "name_en", "type": "string", "constraints": { "required": true } },
          { "name": "icd10", "type": "string" },
          { "name": "since", "type": "string", "constraints": { "required": true } }
